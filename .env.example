# Optional comma-separated reserve text models, in priority order.
# Prefix groq: sends a model to Groq with GROQ_API_KEY, e.g. groq:openai/gpt-oss-120b.
LLM_FALLBACK_MODELS=''
# Models that grade answers and decide whether a message is an answer (tried first, then the chat chain).
LLM_REVIEW_MODELS='groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-120b'
LLM_ROUTER_MODELS='groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-120b'
