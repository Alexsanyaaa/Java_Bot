[Unit]
Description=Java Mentor Telegram bot
Wants=network-online.target
After=network-online.target

[Service]
User=java-mentor
Group=java-mentor
WorkingDirectory=/var/lib/java-mentor-bot
StateDirectory=java-mentor-bot
StateDirectoryMode=0700
EnvironmentFile=/etc/java-mentor-bot/mentor.env
ExecStart=/usr/bin/java -jar /opt/java-mentor-bot/java-mentor-bot.jar
SuccessExitStatus=143
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
